---
import Base from "../layouts/Base.astro";
---

<Base
  title="Contact — Mateo Cerri"
  description="How to reach Mateo Cerri: email, LinkedIn, GitHub. Open to selected freelance work, in English or Spanish."
>
  <div class="wrap">
    <header class="site-head">
      <a class="site-name" href="/">Mateo Cerri</a>
      <nav class="site-nav">
        <a href="/#now">Now</a>
        <a href="/#work">Work</a>
        <a href="/#experiments">Experiments</a>
        <a href="/blog">Blog</a>
        <a href="/contact">Contact</a>
      </nav>
    </header>

    <main>
      <h1>Contact</h1>
      <p class="sec-note">email first, everything else second</p>
      <p>
        I take on selected freelance and consulting work. Remote,
        async-friendly. Write to
        <a href="mailto:hi@mateocerri.com">hi@mateocerri.com</a>;
        I read everything and answer what fits.
      </p>
      <p lang="es">
        Si me escribís desde Argentina o en español: también respondo en
        castellano. Contame qué necesitas y vemos si encaja.
      </p>
      <p>
        Elsewhere: <a href="https://github.com/mateocerri">GitHub</a> for the code, <a href="https://www.linkedin.com/in/mateocerri">LinkedIn</a> for the formalities, <a href="https://es.stackoverflow.com/users/169744/mateo">Stack Overflow en español</a> for the answers.
      </p>
    </main>

    <footer>
      <p>Built with Astro. No JavaScript.</p>
      <p>
        <a href="https://github.com/mateocerri">GitHub</a> · <a href="https://www.linkedin.com/in/mateocerri">LinkedIn</a>
      </p>
    </footer>
  </div>
</Base>
